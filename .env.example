# ============================================================
# AI互动武侠小说游戏 环境变量配置模板
# ============================================================
# 使用方法：复制本文件为 .env，填入你自己的 API 密钥
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
#
# 所有接口均为 OpenAI 兼容格式，任意厂商的密钥均可使用，
# 只需对应修改 BASE_URL 与 MODEL。
# ============================================================


# ---------- ① 主循环模型（剧情生成，必填）----------
# 提供 A/B 两个方案示例，由 MAIN_LOOP_ACTIVE 决定当前生效哪个

# 方案A：DeepSeek 官方（https://platform.deepseek.com 注册获取密钥）
MAIN_LOOP_A_LABEL=DeepSeek 官方
MAIN_LOOP_A_API_KEY=sk-你的deepseek密钥
MAIN_LOOP_A_BASE_URL=https://api.deepseek.com
MAIN_LOOP_A_MODEL=deepseek-chat
MAIN_LOOP_A_TIMEOUT=120

# 方案B：OpenCode Go 聚合网关（https://opencode.ai）
# 一个密钥可调用多家模型（deepseek-v4-flash / gpt-5.6-luna / grok-4.5 等）
MAIN_LOOP_B_LABEL=OpenCode Go
MAIN_LOOP_B_API_KEY=sk-你的opencode密钥
MAIN_LOOP_B_BASE_URL=https://opencode.ai/zen/go/v1
MAIN_LOOP_B_MODEL=deepseek-v4-flash
MAIN_LOOP_B_TIMEOUT=120

# 当前生效方案：A 或 B
MAIN_LOOP_ACTIVE=A


# ---------- ② 辅助模型（状态提取/检定判定，必填，可与主循环同一家）----------
AUX_A_LABEL=DeepSeek 官方
AUX_A_API_KEY=sk-你的deepseek密钥
AUX_A_BASE_URL=https://api.deepseek.com
AUX_A_MODEL=deepseek-chat
AUX_A_TIMEOUT=90

AUX_B_LABEL=OpenCode Go
AUX_B_API_KEY=sk-你的opencode密钥
AUX_B_BASE_URL=https://opencode.ai/zen/go/v1
AUX_B_MODEL=deepseek-v4-flash
AUX_B_TIMEOUT=90

AUX_ACTIVE=A


# ---------- ③ 配图 LLM（可选，不填则无剧情配图）----------
IMG_GEN_A_LABEL=DeepSeek 官方
IMG_GEN_A_API_KEY=sk-你的deepseek密钥
IMG_GEN_A_BASE_URL=https://api.deepseek.com
IMG_GEN_A_MODEL=deepseek-chat
IMG_GEN_A_TIMEOUT=120

IMG_GEN_ACTIVE=A


# ---------- ④ 云端长期记忆（可选，阿里云百炼）----------
# 开通步骤：
#   1. 注册阿里云百炼：https://bailian.console.aliyun.com
#   2. 在「记忆管理」中创建一个记忆库，获得 mem- 开头的 ID
#   3. 填入下面两项即可启用（玩家跨轮次的长期剧情记忆会自动上传）
# 不填则自动降级为纯本地记忆，游戏可正常游玩
DASHSCOPE_API_KEY=sk-你的百炼密钥
BAILIAN_PLOT_MEMORY_ID=mem-你的记忆库ID
ENABLE_CLOUD_MEMORY=true
# 记忆槽位ID：区分不同部署实例的记忆空间，保持默认即可
CLOUD_MEM_SLOT_ID=default_player


# ---------- ⑤ NPC头像/剧情配图生成（可选，SiliconFlow）----------
# 注册：https://siliconflow.cn，不填则使用本地已有头像
KOLORS_IMG_API_URL=https://api.siliconflow.cn/v1/images/generations
KOLORS_IMG_API_KEY=sk-你的siliconflow密钥
KOLORS_IMG_MODEL=Kwai-Kolors/Kolors
KOLORS_IMG_SIZE=1024x1024


# ---------- ⑥ 本地语义向量检索（可选，推荐开启）----------
# 前置：pip install sentence-transformers numpy
# 建议：首次部署先运行 python build_semantic_index.py 预构建向量缓存
# 不安装依赖时自动降级为纯关键词检索，游戏可正常游玩
ENABLE_SEMANTIC_SEARCH=true
SEMANTIC_MODEL=BAAI/bge-small-zh-v1.5
SEMANTIC_MIN_SIMILARITY=0.45
SEMANTIC_SCORE_WEIGHT=2.0
