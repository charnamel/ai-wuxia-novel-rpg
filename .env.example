# ====== 阿里云百炼配置 ======
DASHSCOPE_API_KEY=your-dashscope-api-key
BAILIAN_PLOT_MEMORY_ID=your-plot-memory-id
BAILIAN_WORLD_KNOWLEDGE_ID=
ENABLE_CLOUD_MEMORY=true
CLOUD_MEM_SLOT_ID=default_player_XSFH6

# ====== 语义向量检索配置 ======
ENABLE_SEMANTIC_SEARCH=true
SEMANTIC_MODEL=BAAI/bge-small-zh-v1.5
SEMANTIC_MIN_SIMILARITY=0.45
SEMANTIC_SCORE_WEIGHT=2.0

# ====== 长期记忆后端（cloud=阿里云百炼 / local=本地向量库，改后需重启）======
# local：零API费用，首次启动自动下载约100MB模型（BAAI/bge-small-zh-v1.5）
MEMORY_BACKEND=local
LOCAL_MEMORY_MODEL=BAAI/bge-small-zh-v1.5

# ====== 云向量主动检索（可选：小模型生成关键词→并行查向量库，失败自动降级）======
ACTIVE_RETRIEVAL_ENABLED=false
ACTIVE_RETRIEVAL_API_KEY=
ACTIVE_RETRIEVAL_BASE_URL=
ACTIVE_RETRIEVAL_MODEL=

# ====== 主循环（3选1，MAIN_LOOP_ACTIVE=A/B/C）======
MAIN_LOOP_A_LABEL=DeepSeek v4-Flash (数眼科技)
MAIN_LOOP_A_API_KEY=your-shuyan-api-key
MAIN_LOOP_A_BASE_URL=https://platform.shuyanai.com/v1
MAIN_LOOP_A_MODEL=deepseek-v4-flash-0731
MAIN_LOOP_A_TIMEOUT=120

MAIN_LOOP_B_LABEL=MiMo v2.5-Pro (数眼科技)
MAIN_LOOP_B_API_KEY=your-shuyan-mimo-api-key
MAIN_LOOP_B_BASE_URL=https://platform.shuyanai.com/v1
MAIN_LOOP_B_MODEL=mimo-v2.5-pro
MAIN_LOOP_B_TIMEOUT=120

MAIN_LOOP_C_LABEL=MiMo v2.5 (小米官方)
MAIN_LOOP_C_API_KEY=your-xiaomi-api-key
MAIN_LOOP_C_BASE_URL=https://api.xiaomimimo.com/v1
MAIN_LOOP_C_MODEL=mimo-v2.5
MAIN_LOOP_C_TIMEOUT=120

MAIN_LOOP_ACTIVE=A

# ====== 辅助（2选1，AUX_ACTIVE=A/B）======
AUX_A_LABEL=DeepSeek v4-Flash (官方)
AUX_A_API_KEY=your-deepseek-api-key
AUX_A_BASE_URL=https://api.deepseek.com
AUX_A_MODEL=deepseek-v4-flash
AUX_A_TIMEOUT=90

AUX_B_LABEL=DeepSeek v4-Pro (数眼科技)
AUX_B_API_KEY=your-shuyan-api-key
AUX_B_BASE_URL=https://platform.shuyanai.com/v1
AUX_B_MODEL=deepseek-v4-pro-0813
AUX_B_TIMEOUT=60

AUX_ACTIVE=A

# ====== 配图 LLM（2选1，IMG_GEN_ACTIVE=A/B）======
IMG_GEN_A_LABEL=DeepSeek v4-Flash (官方)
IMG_GEN_A_API_KEY=your-deepseek-api-key
IMG_GEN_A_BASE_URL=https://api.deepseek.com
IMG_GEN_A_MODEL=deepseek-v4-flash
IMG_GEN_A_TIMEOUT=120

IMG_GEN_B_LABEL=DeepSeek v4-Flash (数眼科技)
IMG_GEN_B_API_KEY=your-shuyan-api-key
IMG_GEN_B_BASE_URL=https://platform.shuyanai.com/v1
IMG_GEN_B_MODEL=deepseek-v4-flash-0731
IMG_GEN_B_TIMEOUT=120

IMG_GEN_ACTIVE=A

# ====== Kolors 图片生成 ======
KOLORS_IMG_API_URL=https://api.siliconflow.cn/v1/images/generations
KOLORS_IMG_API_KEY=your-siliconflow-api-key
KOLORS_IMG_MODEL=Kwai-Kolors/Kolors
KOLORS_IMG_SIZE=1024x1024
